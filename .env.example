# Copy to .env in the repository root. Never commit the filled file.
DEVICE_ID=urjagrid-01
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DEVICE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# LOCAL authenticated development only (not accepted as hosted authentication).
# Choose a password of at least 12 characters and an independent random secret.
DASHBOARD_PASSWORD=
SESSION_SECRET=
# Must match the browser address exactly, e.g. http://192.168.1.10:8000 for LAN.
APP_ORIGIN=http://127.0.0.1:8000

# HOSTED: use Supabase's PostgreSQL transaction-pooler URL, with TLS.
# URL-encode special characters in the database password.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Only these pre-created Supabase Auth users may view or control this device.
ALLOWED_EMAILS=
